# Database Connection (SQLite default for development, PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="replace-with-a-very-long-secure-random-secret-key-32-chars-min"
JWT_EXPIRES_IN="7d"

# App & Public URLs
NEXT_PUBLIC_APP_URL="https://krishnaelectronics.com.np"
NEXT_PUBLIC_SITE_NAME="Krishna Electronics Order & Suppliers"
NEXT_PUBLIC_DEFAULT_CURRENCY="NPR"
NEXT_PUBLIC_CURRENCY_SYMBOL="रु"

# Location & Business Details (Birendranagar-12, Surkhet, Nepal)
NEXT_PUBLIC_BUSINESS_LOCATION="Birendranagar-12, Surkhet, Nepal"

# AI Banner Generation (Optional external provider - Gemini / OpenAI / Custom)
# In local/fallback mode, high-fidelity generative SVG/Canvas & curated mock models are used if API key is unconfigured.
GEMINI_API_KEY=""

# Admin Initial Credentials (Used during initial seed)
INITIAL_ADMIN_EMAIL="adminbikram@krishnaelectronics.com.np"
INITIAL_ADMIN_PASSWORD="Bikram@221$#@!"
